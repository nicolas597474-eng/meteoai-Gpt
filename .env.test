# =============================================================================
# MeteoAI Application - Test Environment Variables
# =============================================================================
# This file is used for running tests
# It contains mock/test values that simulate the production environment
# =============================================================================

# -----------------------------------------------------------------------------
# AUTHENTICATION & SESSION
# -----------------------------------------------------------------------------
# Test JWT Secret
JWT_SECRET=test_jwt_secret_key_for_testing_only_1234567890abcdef

# Test Application ID
VITE_APP_ID=test_app_id_12345

# Test OAuth Server URL
OAUTH_SERVER_URL=http://test-oauth-server.com

# Test Owner OpenID
OWNER_OPEN_ID=test_owner_openid

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Test database connection (optional for tests)
DATABASE_URL=mysql://testuser:testpass@localhost:3306/test_meteoai_db

# -----------------------------------------------------------------------------
# NETATMO INTEGRATION
# -----------------------------------------------------------------------------
# Test Netatmo credentials
NETATMO_CLIENT_ID=test_netatmo_client_id
NETATMO_CLIENT_SECRET=test_netatmo_client_secret
NETATMO_REFRESH_TOKEN=test_netatmo_refresh_token
NETATMO_REDIRECT_URI=http://localhost:3000/api/netatmo/callback

# Disable Netatmo verification in tests
NETATMO_VERIFY_CREDENTIALS=false
NETATMO_VERIFY_LIVE=false

# -----------------------------------------------------------------------------
# FORGE API
# -----------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=http://test-forge-api.com
BUILT_IN_FORGE_API_KEY=test_forge_api_key
VITE_FRONTEND_FORGE_API_URL=http://test-forge-api.com
VITE_FRONTEND_FORGE_API_KEY=test_frontend_forge_api_key

# -----------------------------------------------------------------------------
# OAUTH PORTAL
# -----------------------------------------------------------------------------
VITE_OAUTH_PORTAL_URL=http://test-oauth-portal.com

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=test
PORT=3001

# -----------------------------------------------------------------------------
# WEATHER APIS
# -----------------------------------------------------------------------------
OPENWEATHERMAP_API_KEY=test_openweathermap_key
METEOFRANCE_API_KEY=test_meteofrance_key
