# =============================================================================
# MeteoAI Application - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the actual values
# NEVER commit the .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# AUTHENTICATION & SESSION
# -----------------------------------------------------------------------------
# JWT Secret for session signing (REQUIRED)
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_64_characters_recommended

# Application ID (REQUIRED)
VITE_APP_ID=your_application_id_here

# OAuth Server URL (REQUIRED for authentication)
OAUTH_SERVER_URL=https://your-oauth-server-url.com

# Owner OpenID (for admin privileges)
OWNER_OPEN_ID=your_owner_openid_here

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# MySQL/TiDB connection string (REQUIRED)
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/meteoai_db

# -----------------------------------------------------------------------------
# NETATMO INTEGRATION
# -----------------------------------------------------------------------------
# Netatmo OAuth credentials (REQUIRED for Netatmo features)
NETATMO_CLIENT_ID=your_netatmo_client_id
NETATMO_CLIENT_SECRET=your_netatmo_client_secret

# Netatmo refresh token (for existing integrations)
NETATMO_REFRESH_TOKEN=your_netatmo_refresh_token

# Netatmo redirect URI (default: https://meteoai-7i8fkmsr.manus.space/api/netatmo/callback)
NETATMO_REDIRECT_URI=https://your-domain.com/api/netatmo/callback

# Netatmo verification flags (for testing)
NETATMO_VERIFY_CREDENTIALS=false
NETATMO_VERIFY_LIVE=false

# -----------------------------------------------------------------------------
# FORGE API (External Services)
# -----------------------------------------------------------------------------
# Forge API URL (REQUIRED for external services)
BUILT_IN_FORGE_API_URL=https://forge.butterfly-effect.dev

# Forge API Key (REQUIRED for external services)
BUILT_IN_FORGE_API_KEY=your_forge_api_key_here

# Frontend Forge API (for Google Maps proxy)
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_api_key_here

# -----------------------------------------------------------------------------
# OAUTH PORTAL
# -----------------------------------------------------------------------------
# OAuth portal URL for frontend authentication
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal-url.com

# -----------------------------------------------------------------------------
# WEATHER APIS (Optional - fallback to simulation if not provided)
# -----------------------------------------------------------------------------
# OpenWeatherMap API Key
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# AROME passe uniquement par Open-Meteo (modèle meteofrance_arome_france_hd, sans clé) :
# le chemin par défaut ne lit aucune clé Météo-France et n’appelle ni OAuth2 ni WCS.
#
# Chemin hérité WCS/GeoTIFF (réversible, désactivé par défaut) : seule la valeur
# "true" réactive l’ancien appel authentifié à l’API AROME Météo-France.
# AROME_WCS_ENABLED=false
#
# MeteoFrance — identifiant d’application OAuth2 (APPLICATION_ID), chemin hérité uniquement.
# Ignoré tant que AROME_WCS_ENABLED n’est pas "true". Ce n’est NI une clé API, NI un
# jeton d’accès, NI le jeton du site/appli mobile.
# Valeur attendue : la chaîne base64 affichée dans la commande curl du portail
#   portail-api.meteofrance.fr > Mes API > API AROME (haute résolution) > « Générer un token »
#   curl -X POST https://portail-api.meteofrance.fr/token \
#        -d "grant_type=client_credentials" -H "Authorization: Basic <APPLICATION_ID>"
# Une paire « client_id:client_secret » en clair est acceptée et encodée automatiquement.
# L’APPLICATION_ID est propre à chaque abonnement : celui d’une autre API du portail est refusé.
# METEOFRANCE_API_KEY=your_meteofrance_oauth2_application_id_base64

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Node environment (development, production, test)
NODE_ENV=development

# Application port
PORT=3000

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
# Session cookie settings
# Cookie name (default: meteoai_session)
COOKIE_NAME=meteoai_session

# Session duration in milliseconds (default: 1 year)
ONE_YEAR_MS=31536000000

# AXIOS timeout in milliseconds (default: 10000)
AXIOS_TIMEOUT_MS=10000

# =============================================================================
# TESTING ENVIRONMENT
# =============================================================================
# For running tests, create a separate .env.test file with test-specific values
# =============================================================================
